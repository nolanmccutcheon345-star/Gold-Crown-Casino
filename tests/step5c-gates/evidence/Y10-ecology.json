    "squeeze": "Raise after open and cold call / legal re-raise opportunity after open and cold call",
    "foldToThreeBet": "Fold / opener first priced response after second preflop raise",
    "blindDefense": "Call or raise / SB or BB first priced response to open",
    "flopCbet": "Bet / last preflop raiser first legal unopened-flop opportunity",
    "turnBarrel": "Bet turn / previous flop aggressor first legal unopened-turn opportunity",
    "riverBarrel": "Bet river / previous turn aggressor first legal unopened-river opportunity",
    "checkRaise": "Raise after checking / first later legal raise opportunity facing price on same street",
    "foldToCbet": "Fold / first response to a true flop cbet",
    "drawCall": "Call / visible private-contribution draw facing price before river",
    "drawRaise": "Raise / private-contribution draw with legal raising before river",
    "valueBet": "Bet/raise / legal raising opportunity with operational private two-pair+ or top-pair value proxy",
    "airBet": "Bet/raise / legal raising opportunity with unpaired no-live-draw proxy (not true bluff intention)",
    "riverBluffCatch": "Call / river priced decision with one private pair proxy",
    "foldSmall": "Fold / facing last postflop bet or raise increment ≤25% of pot after the raiser called, frozen at that raise event",
