    "limp": "Call before any voluntary action / priced unopened decision",
    "overlimp": "Call behind limper / priced unraised decision after voluntary call",
    "isolation": "Raise over limper(s) / unraised decision after voluntary call with legal raising",
    "coldCall": "Call with no prior voluntary contribution, nonblind seat / priced first response to one open",
